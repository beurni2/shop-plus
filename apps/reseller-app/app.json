{
  "expo": {
    "name": "Shop+",
    "slug": "shop-plus-reseller",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFDF7",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "bf.shopplus.reseller"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Shop+ utilise le micro pour enregistrer vos notes vocales sur vos articles."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Bricolage-ExtraBold.ttf",
            "./assets/fonts/Instrument-Regular.ttf",
            "./assets/fonts/Instrument-SemiBold.ttf",
            "./assets/fonts/Instrument-Bold.ttf"
          ]
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
